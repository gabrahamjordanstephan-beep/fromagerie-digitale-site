# Cal.com — https://app.cal.com
# Username Cal.com du compte agence (ex: fromagerie-digitale)
NEXT_PUBLIC_CAL_USERNAME=
# Slug de l'event type "appel découverte 30 min"
NEXT_PUBLIC_CAL_EVENT_SLUG=decouverte-30min

# Site
NEXT_PUBLIC_SITE_URL=https://fromageriedigitale.com

# Sanity (Sprint 4+ — migration blog)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
