# Formulaire de contact, envoi des emails avec Resend (https://resend.com)
# Clé API Resend
RESEND_API_KEY=
# Adresse qui reçoit les demandes
CONTACT_TO_EMAIL=contact@fromageriedigitale.com
# Expéditeur, sur un domaine vérifié dans Resend
CONTACT_FROM_EMAIL="Fromagerie Digitale <formulaire@fromageriedigitale.com>"

# Site
NEXT_PUBLIC_SITE_URL=https://fromageriedigitale.com
